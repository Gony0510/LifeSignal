[Unit]
Description=LifeSignal radar AI and dashboard server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/LifeSignal
ExecStart=%h/LifeSignal/.venv/bin/python %h/LifeSignal/server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
